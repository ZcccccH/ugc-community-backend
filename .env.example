# Copy to .env (never commit .env) or export these variables before starting the server.

# --- Database (required) ---
DB_URL=jdbc:mysql://localhost:3306/ugc_community?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=
DB_PASSWORD=

# --- Auth token signing (required, >= 32 random characters) ---
# Generate with: openssl rand -base64 48
JWT_SECRET=

# --- HTTP / security ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY=false
RATE_LIMIT_ENABLED=true
# Contact-based password reset has no OTP; keep false unless you add verification
PASSWORD_RESET_BY_CONTACT_ENABLED=false

# --- Optional request/response signing for official clients ---
API_SIGNATURE_ENABLED=false
API_SIGNATURE_PUBLIC_KEY=

# --- File uploads ---
UGC_UPLOAD_DIR=./uploads

# --- Optional Qiniu object storage ---
QINIU_ENABLED=false
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
QINIU_DOMAIN=
QINIU_REGION=auto
QINIU_PREFIX=uploads

# --- Optional AI chat (DeepSeek-compatible API) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
